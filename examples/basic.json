{
  "schema_version": "1.0",
  "execution_mode": "offline_mock",
  "config": {"max_running": 2, "max_running_per_tenant": 1, "max_pending": 8},
  "jobs": [
    {
      "job_id": "summarize-a", "tenant": "alpha", "priority": 8,
      "max_tool_calls": 2, "max_tokens": 60,
      "estimates": {
        "tokens": 100, "duration_ms": 200,
        "cost": {"amount": "0.50", "currency": "USD", "source": "submitted_estimate"}
      },
      "operations": [
        {"tool": "lookup.record", "token_upper_bound": 0,
         "arguments": {"record": "release-a", "delay_ms": 5}},
        {"tool": "model.generate", "token_upper_bound": 60,
         "arguments": {"input_tokens": 30, "output_tokens": 10, "delay_ms": 5}}
      ]
    },
    {
      "job_id": "summarize-b", "tenant": "beta", "priority": 1,
      "max_tool_calls": 2, "max_tokens": 40,
      "estimates": {
        "tokens": 200, "duration_ms": 300,
        "cost": {"amount": "0.75", "currency": "USD", "source": "submitted_estimate"}
      },
      "operations": [
        {"tool": "lookup.record", "token_upper_bound": 0,
         "arguments": {"record": "release-b", "delay_ms": 5}},
        {"tool": "model.generate", "token_upper_bound": 40,
         "arguments": {"input_tokens": 20, "output_tokens": 5, "delay_ms": 5}}
      ]
    }
  ]
}
